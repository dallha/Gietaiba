# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 🟣 PHASE NEON-AUTH-1.0 (PoC)
# ------------------------------------------------------------------------------
# L'URL du service Neon Auth managé (ex: https://ep-xxx.neonauth.tech)
# Ce lien connecte le backend (Express) et le frontend (React via VITE_) au service.
NEON_AUTH_URL="A_CONFIGURER_SUR_RENDER"
VITE_NEON_AUTH_URL="A_CONFIGURER_SUR_RENDER"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL Neon Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# SESSION_SECRET: 64-char hex or 32+ char strong random secret for HMAC token signing (Mandatory in production)
SESSION_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# GOOGLE_CLIENT_ID: OAuth 2.0 client ID from Google Cloud Console (APIs & Services → Credentials)
# MUST be set in Render Environment — never commit the real value to git.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: OAuth 2.0 client secret from Google Cloud Console
# MUST be set in Render Environment — never commit the real value to git.
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

