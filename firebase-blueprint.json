{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "GIE Voyage ERP Database Schema",
  "entities": {
    "Setting": {
      "title": "Setting",
      "description": "System settings and company configuration",
      "type": "object",
      "properties": {
        "agencyName": { "type": "string" },
        "currency": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["agencyName", "currency"]
    },
    "User": {
      "title": "User",
      "description": "Application user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "clientId": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "Pilgrim profile and identity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "gender": { "type": "string" },
        "birthDate": { "type": "string" },
        "nationality": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "firstName", "lastName", "phone"]
    },
    "Voyage": {
      "title": "Voyage",
      "description": "Hajj and Umrah travel campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "year": { "type": "number" },
        "departureDate": { "type": "string" },
        "returnDate": { "type": "string" },
        "capacity": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "name", "type", "year"]
    },
    "Package": {
      "title": "Package",
      "description": "Travel package offer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "voyageId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "voyageId", "name", "price"]
    },
    "Inscription": {
      "title": "Inscription",
      "description": "Pilgrim registration linking Client, Voyage and Package",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "clientId": { "type": "string" },
        "voyageId": { "type": "string" },
        "packageId": { "type": "string" },
        "appliedPrice": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "clientId", "voyageId", "packageId", "appliedPrice"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "clientId": { "type": "string" },
        "inscriptionId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "receiptNumber", "clientId", "inscriptionId", "amount", "paymentMethod"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Central synchronized notification across ERP and Pilgrim Portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUserId": { "type": "string" },
        "recipientClientId": { "type": "string" },
        "inscriptionId": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "priority": { "type": "string" },
        "isRead": { "type": "boolean" },
        "actionUrl": { "type": "string" }
      },
      "required": ["recipientUserId", "type", "title", "message", "isRead"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "System settings collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Pilgrim profiles"
    },
    "/voyages/{voyageId}": {
      "schema": { "$ref": "#/entities/Voyage" },
      "description": "Hajj and Umrah travels"
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/Package" },
      "description": "Voyage packages"
    },
    "/inscriptions/{inscriptionId}": {
      "schema": { "$ref": "#/entities/Inscription" },
      "description": "Pilgrim voyage registrations"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payment records"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Central synchronized notifications collection"
    }
  }
}
